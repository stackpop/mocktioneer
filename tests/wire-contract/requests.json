{
  "version": 1,
  "base_url": "http://127.0.0.1:8787",
  "environment": {
    "MOCKTIONEER_TS_DOMAINS": "ts.publisher.com",
    "MOCKTIONEER_PULL_TOKEN": "wire-test-token"
  },
  "generators": {
    "body_pad_to": "UTF-8 body plus ASCII spaces to exact total byte count; valid JSON, same parsed request",
    "target_pad": "append this many ASCII x bytes to path",
    "extra_headers": "append X-Wire-000: x through X-Wire-(n-1): x in order"
  },
  "accepted_differences": {
    "F1": {
      "contract": "internal error.message only becomes internal server error; status/kind/shape unchanged",
      "corpus_scope": "not exercised: no internal-error injection"
    },
    "F2": {
      "contract": "missing-blob error.message changes em dash to semicolon; deserialization hint removed; ConfigStoreError fixed text; status/kind/Retry-After unchanged",
      "corpus_scope": "unseeded cases permit only the exact missing-blob message and resulting Content-Length delta"
    },
    "F3": {
      "contract": "unopenable store changes Axum/Cloudflare 500 to 503 service_unavailable without Retry-After; oversized Axum snapshot fails startup",
      "corpus_scope": "not exercised: unseeded means absent key, not malformed/unreadable snapshot"
    },
    "F4": {
      "contract": "405 adds sorted deduplicated Allow",
      "corpus_scope": "method-not-allowed cases: only add exact case.allow header; body and remaining ordered headers stay exact"
    },
    "F5": {
      "contract": "adapter-visible target over 8192 -> 414; over 100 normalized headers or 64KiB -> 431; surviving framing ambiguity -> 400; no CORS on errors",
      "corpus_scope": "head cases accept only exact target/count error payload, status, framing and lost CORS; raw TCP cases are report-only"
    },
    "F6": {
      "contract": "observed default 30-second body-read deadline -> 408",
      "corpus_scope": "not exercised: timeout cases are nondeterministic; contract tests cover budgets"
    },
    "F7": {
      "contract": "default JSON body cap is 8MiB; excess -> 400 request body too large",
      "corpus_scope": "mediation-over-8mib: only exact error payload, status, Content-Length and CORS removal"
    },
    "F8": {
      "contract": "Axum parses JSON without application/json Content-Type",
      "corpus_scope": "no-content-type/text-plain cases: exact old streaming-body 400 becomes bytes equivalent to matching successful reference"
    },
    "F9": {
      "contract": "Axum HTTP/1 only; 256 connections; 10-second head/idle close; Hyper raw head limits",
      "corpus_scope": "head cases may expose adapter validation; raw characterization separately records parser output; no blanket response exception"
    },
    "F10": {
      "contract": "strip hop-by-hop fields, canonicalize Content-Length and 204/205/304/HEAD body rules",
      "corpus_scope": "Only the exact HeaderMap length-group swap/remove/reinsert permutation, preserving names, values and duplicate order; C6 ordinary empty cases additionally permit their exact first-insertion permutation. Host Date remains last. No sorting or general header filtering."
    },
    "F11": {
      "contract": "JWKS redirects are not followed",
      "corpus_scope": "excluded from local corpus: public signed-success host needed"
    },
    "F12": {
      "contract": "sanitized outbound error strings; buffered error-stage/precedence changes; content decoding and negotiation",
      "corpus_scope": "excluded from local corpus: no outbound/public JWKS requests"
    },
    "F13": {
      "contract": "manifest capabilities and bid trigger class fields",
      "corpus_scope": "introspection excluded from wire corpus"
    },
    "C1": {
      "contract": "bid-route body-read budget is 10 seconds",
      "corpus_scope": "contract tests; no timing mask or wire exception"
    },
    "C2": {
      "contract": "observed 2-second config deadline -> 503 service_unavailable",
      "corpus_scope": "contract tests; no timing mask or wire exception"
    },
    "C3": {
      "contract": "auction and APS JSON bodies over 1MiB -> 400 request body too large",
      "corpus_scope": "over-1mib cases: only exact error payload, status, Content-Length and CORS removal"
    },
    "C4": {
      "contract": "poisoned JWKS cache lock is a miss",
      "corpus_scope": "contract tests; no wire exception"
    },
    "C5": {
      "contract": "JWKS cache canonical-host keys and 32-entry/2MiB owned-allocation bounds",
      "corpus_scope": "contract tests; no wire exception"
    },
    "C6": {
      "contract": "ordinary empty buffered response has explicit Content-Length: 0 when status permits",
      "corpus_scope": "empty cases permit only addition of that exact field"
    },
    "C7": {
      "contract": "JWKS outbound budget is 5 seconds; observed expiry becomes failed verification adm while status stays 200",
      "corpus_scope": "contract tests; no time-dependent wire exception"
    }
  },
